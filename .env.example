# Copy to .env. With nothing filled in, the app runs offline with labelled stand-ins.

# offline = local stand-ins, no keys needed | live = AWS Bedrock + Pinecone
APP_MODE=offline
# mock = local heuristic stand-in for Jev | live = real Jev API
JEV_MODE=mock

# AWS (for Bedrock). Either set a profile from ~/.aws, or access keys.
AWS_REGION=us-east-1
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# pinecone.io API key
PINECONE_API_KEY=

# Jev (TypeSafe AI) API key
JEV_API_KEY=

# Everything else (model IDs, index name, thresholds, retries, prices) has a default in
# backend/remediation_rag/config.py. To override one, add it here in UPPER_CASE, e.g.
# BEDROCK_GENERATION_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# MAX_RETRIES=2
