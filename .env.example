# Copy to .env and fill in the keys below.
# For a no-keys demo instead, set APP_MODE=offline (labelled local stand-ins).

# live = AWS Bedrock + Pinecone | offline = local stand-ins, no keys needed
APP_MODE=live
# Decision layer: auto = Jev if JEV_API_KEY is set, otherwise an adversarial LLM judge
# on Bedrock (offline: heuristic mock). Force one with live | llm | mock.
JEV_MODE=auto

# AWS (for Bedrock). Simplest: a Bedrock API key (Bedrock console -> API keys).
# Alternatively leave it blank and use a profile from ~/.aws, or IAM access keys.
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# pinecone.io API key
PINECONE_API_KEY=

# Jev (TypeSafe AI) API key. Optional: leave blank to use the LLM judge instead.
JEV_API_KEY=

# Everything else (model IDs, index name, thresholds, retries, prices) has a default in
# backend/remediation_rag/config.py. To override one, add it here in UPPER_CASE, e.g.
# BEDROCK_GENERATION_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# MAX_RETRIES=2
