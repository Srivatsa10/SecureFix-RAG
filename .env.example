# Copy to .env and fill in. Read by the backend (pydantic-settings) and docker-compose.
# With the defaults below the whole stack runs locally with NO API keys (offline mode).

# --- Runtime mode ---------------------------------------------------------------------
# offline: in-memory index + hashed embeddings + rule-based generator (no AWS/Pinecone)
# live:    Bedrock (generation + Titan embeddings) + Pinecone
APP_MODE=offline
# mock: MockJevClient (local heuristics, clearly labelled everywhere). live: real Jev API.
JEV_MODE=mock
LOG_LEVEL=INFO

# --- AWS Bedrock (APP_MODE=live) ------------------------------------------------------
# Standard AWS credential chain: env vars below, AWS_PROFILE, or an instance/task role.
AWS_REGION=us-east-1
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Use the model / inference-profile ID shown in your Bedrock console for your region.
BEDROCK_GENERATION_MODEL_ID=anthropic.claude-opus-5
BEDROCK_GENERATION_MAX_TOKENS=4096
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# --- Pinecone (APP_MODE=live) ---------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=remediation-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE_INTERNAL=internal-secure-code
PINECONE_NAMESPACE_OWASP=owasp-guidance

# --- Jev / TypeSafe AI (JEV_MODE=live) ------------------------------------------------
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=5
JEV_MAX_ATTEMPTS=3

# --- Pipeline tuning ------------------------------------------------------------------
MAX_RETRIES=3
SCORE_THRESHOLD=0.85
INTENT_THRESHOLD=0.6
RELEVANCE_THRESHOLD=0.5
RETRIEVAL_TOP_K=4

# --- Cost model, USD per 1M tokens (used for the cost comparison) ---------------------
# Bedrock prices are partner-set and vary by region: replace with your price sheet.
PRICE_GENERATION_INPUT_PER_M=5.00
PRICE_GENERATION_OUTPUT_PER_M=25.00
PRICE_JEV_INPUT_PER_M=0.042
# Counterfactual LLM judge (defaults: Claude Haiku 4.5 list price).
PRICE_JUDGE_INPUT_PER_M=1.00
PRICE_JUDGE_OUTPUT_PER_M=5.00
JUDGE_OUTPUT_TOKENS_PER_DECISION=150
JUDGE_PROMPT_OVERHEAD_TOKENS=350

# --- API ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
